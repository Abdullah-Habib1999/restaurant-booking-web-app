# ==============================================================================
# TableReserve - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Atlas (Server-Side ONLY - NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Connection string from MongoDB Atlas -> Clusters -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database name in MongoDB Atlas cluster (default: tablereserve)
MONGODB_DB_NAME=tablereserve

# ------------------------------------------------------------------------------
# Super Admin Security & Recovery Secrets
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HMAC admin session tokens
ADMIN_SESSION_SECRET=replace-with-a-random-32-char-secret-string

# Bootstrap secret required ONLY if you ever need to reset or re-initialize
# an administrator when one already exists.
ADMIN_BOOTSTRAP_SECRET=replace-with-a-secure-bootstrap-key

# ------------------------------------------------------------------------------
# Application URL (Optional, for absolute redirects and email link generation)
# ------------------------------------------------------------------------------
# In Netlify production, Netlify automatically sets URL or you can specify:
NEXT_PUBLIC_APP_URL=https://restaurant-booking-web-app.netlify.app
